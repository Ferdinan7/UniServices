# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Logging Configuration
# Habilitar/deshabilitar logging de operaciones de Supabase (default: true)
SUPABASE_LOGGING_ENABLED=true

# Logs detallados: incluye parámetros completos y resultados (default: false)
# Útil para debugging, pero puede generar muchos logs
SUPABASE_DETAILED_LOGS=true

# Loggear parámetros de queries (default: false)
# ADVERTENCIA: Puede exponer datos sensibles (passwords, tokens)
# Solo habilitar en desarrollo/debugging
SUPABASE_LOG_PARAMS=false

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (si aplica)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d
